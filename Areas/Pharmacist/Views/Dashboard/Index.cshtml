@{
    Layout = "_PharmacistLayout";
}

<h2>Pharmacist Dashboard</h2>

<input id="nicInput" placeholder="Enter NIC" />
<button onclick="searchPatient()">Search</button>

<p id="msg" style="color:red"></p>

<div id="popup" style="display:none;">

    <h3 id="name"></h3>
    <p id="nic"></p>

    <table border="1">
        <thead>
            <tr>
                <th>Medicine</th>
                <th>Dosage</th>
                <th>Duration</th>
                <th>Times</th>
                <th>Status</th>
                <th>Reason</th>
            </tr>
        </thead>

        <tbody id="table"></tbody>
    </table>

    <button onclick="saveData()">Confirm</button>
    <button onclick="generateExternal()">External PDF</button>
</div>

<script src="~/js/pharmacist/pharmacist.js"></script>