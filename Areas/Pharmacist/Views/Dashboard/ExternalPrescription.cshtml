@model ClinicOne.Models.ViewModels.Pharmacist.ExternalPrescriptionPdfModel

<h2>ClinicOne External Prescription</h2>

<p><b>Patient Name:</b> @Model.PatientName</p>
<p><b>Patient NIC:</b> @Model.NIC</p>
<p><b>Doctor Notes:</b> @Model.Notes</p>

<table border="1" width="100%">
    <thead>
        <tr>
            <th>Medicine</th>
            <th>Dosage</th>
            <th>Duration</th>
            <th>Times Per Day</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var m in Model.Medicines)
        {
            <tr>
                <td>@m.MedicineName</td>
                <td>@m.Dosage</td>
                <td>@m.Duration</td>
                <td>@m.TimesPerDay</td>
            </tr>
        }
    </tbody>
</table>