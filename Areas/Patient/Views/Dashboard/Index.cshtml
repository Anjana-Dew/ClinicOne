@model ClinicOne.Models.ViewModels.Patient.PatientDashboardViewModel

@{
    Layout = "_PatientLayout";
}

<link rel="stylesheet" href="~/css/patient/patientDashboardStyles.css" />
<script src="~/js/patient/patientDashboard.js"></script>

<div class="dashboard-wrapper">

    <div class="dashboard-header">
        <h2>🏥 Patient Dashboard</h2>
        <p>Overview of your health and medical activity</p>
    </div>

    <div class="dashboard-grid">

        <!-- PROFILE -->
        <div class="card profile-card">

            <div class="profile-img">
                <img src="/patientImages/defaultProfile.png" />
            </div>

            <h3>@Model.PatientName</h3>

            <div class="profile-info">
                <p><span class="label">NIC:</span> @ViewBag.NIC</p>
                <p>
                    <span class="label">Blood:</span>
                    @(!string.IsNullOrEmpty(ViewBag.BloodType) ? ViewBag.BloodType : "⚠ Add Blood Type")
                </p>
                <p><span class="label">Phone:</span> @Model.PhoneNumber</p>
                <p><span class="label">Address:</span> @Model.Address</p>
            </div>

            <a href="/Patient/Profile/Edit" class="btn primary">
                Edit Profile
            </a>

        </div>

        <!-- NEXT SESSION -->
        <div class="card next-session">

            <div class="card-header">
                <h3>📅 Next Session</h3>
            </div>

            @if (Model.NextSessionDate != null)
            {
                <div class="next-session-box">

                    <h3>@ViewBag.NextSessionName</h3>

                    <div class="big-date">
                        @Model.NextSessionDate.Value.ToString("dddd, dd MMM yyyy")
                    </div>

                    <div class="time">
                        @Model.SessionTime
                    </div>

                    <div id="countdown"
                         data-date="@Model.NextSessionDate.Value.ToString("yyyy-MM-dd")"
                         data-time="@ViewBag.StartTime">
                        ⏳ Calculating...
                    </div>

                </div>
            }
            else
            {
                <p class="muted">No upcoming session</p>
            }

        </div>

        <!-- HEALTH PROGRESS -->
        <div class="card">

            <div class="card-header">
                <h3>📈 Health Progress</h3>
            </div>

            <div class="progress-status @Model.ProgressStatus.ToLower()">
                @Model.ProgressStatus
            </div>

            <div class="progress-bar">
                <div class="progress-fill @Model.ProgressStatus.ToLower()"></div>
            </div>

            <p class="notes">
                <strong>Doctor Notes:</strong><br />
                @Model.DoctorNotes
            </p>

        </div>

        <!-- HEALTH SUMMARY -->
        <div class="card">

            <div class="card-header">
                <h3>🧬 Health Summary</h3>
            </div>

            <div class="health-grid">

                <div class="health-box">
                    <img src="/icons/bmi.png" />
                    <div>BMI</div>
                    <h4>@Model.BMI</h4>
                </div>

                <div class="health-box">
                    <img src="/icons/weight.png" />
                    <div>Weight</div>
                    <h4>@Model.Weight kg</h4>
                </div>

                <div class="health-box">
                    <img src="/icons/height.png" />
                    <div>Height</div>
                    <h4>@Model.Height cm</h4>
                </div>

                <div class="health-box">
                    <img src="/icons/pressure.png" />
                    <div>BP</div>
                    <h4>@Model.BloodPressure</h4>
                </div>

            </div>

        </div>

        <!-- REPORT -->
        <div class="card">

            <div class="card-header">
                <h3>📄 Latest Report</h3>
            </div>

            <table class="mini-table">
                <tr><td>ID</td><td>@ViewBag.ReportID</td></tr>
                <tr><td>Test</td><td>@ViewBag.TestName</td></tr>
                <tr><td>Results</td><td>@ViewBag.Result</td></tr>
                <tr><td>Date</td><td>@ViewBag.ReportDate</td></tr>
                <tr><td>Status</td><td>@Model.ReportStatus</td></tr>
            </table>

            <div class="report-actions">
                <a href="@Model.ReportPath" class="btn success">Download</a>
                <a href="/Patient/Reports" class="btn primary">View All</a>
            </div>

        </div>

        <!-- MEDICINES -->
        <div class="card">

            <div class="card-header">
                <h3>💊 Current Medicines</h3>
            </div>

            <div class="medicine-list scroll">

                @foreach (var med in Model.Medicines.Take(3))
                {
                    <div class="medicine-item">
                        <strong>@med.Name</strong>
                        <span>@med.Dosage</span>
                    </div>
                }

            </div>

            <a href="/Patient/Prescriptions" class="btn primary">
                View All
            </a>

        </div>

    </div>
</div>

<div id="editModal" class="modal">
    <div class="modal-content">

        <span class="close" onclick="closeEditProfile()">&times;</span>

        <h3>Edit Profile</h3>

        <form method="post" action="/Patient/Profile/Update">

            <label>Full Name</label>
            <input type="text" name="FullName" value="@Model.PatientName" required />

            <label>Phone</label>
            <input type="text" name="PhoneNumber" value="@Model.PhoneNumber" required />

            <label>Blood Type</label>
            <input type="text" name="BloodType" value="@Model.BloodType" />

            <label>Address</label>
            <input type="text" name="Address" value="@Model.Address" />

            <button type="submit" class="btn success">Save</button>

        </form>

    </div>
</div>

@section Scripts {
    <script>
        const el = document.getElementById("countdown");

        if (el) {
            const target = new Date(el.dataset.date + "T00:00:00");

            setInterval(() => {
                const now = new Date();
                const diff = target - now;

                if (diff <= 0) {
                    el.innerHTML = "Session Started";
                    return;
                }

                const d = Math.floor(diff / (1000*60*60*24));
                const h = Math.floor((diff/(1000*60*60))%24);
                const m = Math.floor((diff/(1000*60))%60);

                el.innerHTML = d + "d " + h + "h " + m + "m";
            }, 1000);
        }
    </script>
}