@model ClinicOne.Models.ViewModels.Patient.PatientDashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_PatientLayout.cshtml";
}

<link rel="stylesheet" href="~/css/patient/patientDashboardStyles.css" />

<div class="dashboard-grid">

    <!-- PROFILE -->
    <div class="card profile-card">

        <h3>Profile</h3>

        <img src="~/patientImages/account.png" class="profile-img" />

        <h4>@ViewBag.PatientName</h4>

        <div class="profile-info">
            <p>Gender: @Model.Gender</p>
            <p>Age: @Model.Age</p>
            <p>Blood: @Model.BloodType</p>
        </div>

        <button class="btn-modern" onclick="openEditProfile()">
            Edit Profile
        </button>

    </div>



    <!-- UPCOMING CLINIC -->
    <div class="card">

        <div class="card-header">
            <img src="/icons/calendar.png" class="card-icon" />
            <h3>Upcoming Clinic</h3>
        </div>

        <div class="calendar">

            <div class="calendar-header">
                <span>Clinic Dates</span>
            </div>

            <div class="calendar-days">
                <div>Su</div><div>Mo</div><div>Tu</div>
                <div>We</div><div>Th</div><div>Fr</div><div>Sa</div>
            </div>

            <div class="calendar-dates">

                <div>1</div>
                <div>2</div>
                <div class="clinic-date">3</div>
                <div>4</div>
                <div>5</div>
                <div class="clinic-date">6</div>
                <div>7</div>

                <div>8</div>
                <div>9</div>
                <div>10</div>
                <div class="clinic-date">11</div>
                <div>12</div>
                <div>13</div>
                <div>14</div>

                <div>15</div>
                <div>16</div>
                <div>17</div>
                <div>18</div>
                <div class="clinic-date">19</div>
                <div>20</div>
                <div>21</div>

            </div>

        </div>

        <p class="clinic-info">
            Next Clinic : <strong>@Model.NextSessionDate</strong>
        </p>

    </div>



    <!-- HEALTH PROGRESS -->
    <div class="card">

        <div class="card-header">
            <img src="/icons/progress.png" class="card-icon" />
            <h3>Health Progress</h3>
        </div>

        <div class="progress-highlight @Model.ProgressStatus.ToLower()">
            @Model.ProgressStatus
        </div>

        <div class="notes-section">

            <h4 class="notes-title">
                <img src="/icons/notes.png" class="note-icon" />
                Notes
            </h4>

            <p>@Model.DoctorNotes</p>

        </div>

    </div>



    <!-- HEALTH SUMMARY -->
    <div class="card">

        <div class="card-header">
            <img src="/icons/health.png" class="card-icon" />
            <h3>Health Summary</h3>
        </div>

        <div class="health-items">

            <div class="health-box bmi">
                <img src="/icons/bmi.png" />
                <span>BMI</span>
                <h4>@Model.BMI</h4>
            </div>

            <div class="health-box weight">
                <img src="/icons/weight.png" />
                <span>Weight</span>
                <h4>@Model.Weight kg</h4>
            </div>

            <div class="health-box height">
                <img src="/icons/height.png" />
                <span>Height</span>
                <h4>@Model.Height cm</h4>
            </div>

            <div class="health-box bp">
                <img src="/icons/pressure.png" />
                <span>Blood Pressure</span>
                <h4>@Model.BloodPressure</h4>
            </div>

        </div>

    </div>



    <!-- TEST REPORT -->
    <div class="card">

        <div class="card-header">
            <img src="/icons/report.png" class="card-icon" />
            <h3>Latest Test Report</h3>
        </div>

        <p>@Model.LatestReportName</p>

        <span class="report-status">
            @Model.ReportStatus
        </span>

        <a class="btn-modern" href="@Model.ReportPath">
            View Report
        </a>

    </div>



    <!-- MEDICINES -->
    <div class="card">

        <div class="card-header">
            <img src="/icons/medicine.png" class="card-icon" />
            <h3>Current Medicines</h3>
        </div>

        <div class="medicine-list">

            @foreach (var med in Model.Medicines)
            {
                <div class="medicine-item">

                    <span class="pill">💊</span>

                    <div>
                        <strong>@med.Name</strong><br />
                        <small>@med.Dosage</small>
                    </div>

                </div>
            }

        </div>

    </div>

</div>



<!-- EDIT PROFILE MODAL -->

<div id="editModal" class="modal">

    <div class="modal-content">

        <h3>Edit Profile</h3>

        <label>Name</label>
        <input type="text" value="@ViewBag.PatientName" />

        <label>Phone</label>
        <input type="text" />

        <label>Address</label>
        <input type="text" />

        <label>Blood Type</label>
        <input type="text" />

        <p class="note">NIC cannot be changed</p>

        <button class="btn-modern">
            Save
        </button>

        <button class="btn-cancel" onclick="closeEditProfile()">
            Cancel
        </button>

    </div>

</div>



@section Scripts {
    <script src="~/js/patient/patientDashboard.js"></script>
}