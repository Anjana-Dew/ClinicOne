@model ClinicOne.Models.ViewModels.Patient.PatientDashboardViewModel
@{
    Layout = "_PatientLayout";
}

<link rel="stylesheet" href="~/css/patient/patientDashboardStyles.css" />
<script src="/js/patient/patientDashboard.js"></script>

<div class="dashboard-wrapper">

    <div class="header">
        <h2>Patient Dashboard</h2>
        <p>Your medical overview</p>
    </div>

    <div class="grid">

        <div class="card profile profile-hero">

            <img src="/patientImages/defaultProfile.png" class="profile-img" />

            <h3 id="profileName">@Model.PatientName</h3>

            <p class="profile-sub">Patient Profile</p>

            <div class="info">
                <div><span>NIC</span><b>@Model.NIC</b></div>
                <div><span>Phone</span><b id="profilePhone">@Model.PhoneNumber</b></div>
                <div><span>Address</span><b id="profileAddress">@Model.Address</b></div>
                <div><span>Blood</span><b id="profileBlood">@Model.BloodType</b></div>
            </div>

            <button type="button" class="btn primary full" onclick="openModal()">
                Edit Profile
            </button>

        </div>

        <!-- NEXT SESSION -->
        <div class="card next-session">

            <h3>Next Session</h3>

            @if (Model.NextSessionDate != null)
            {
                <div class="next-session-box">

                    <h3>@Model.NextSessionName</h3>

                    <div class="big-date">
                        @Model.NextSessionDate.Value.ToString("yyyy-MM-dd")
                    </div>

                    <div class="time">
                        @Model.SessionStartTime - @Model.SessionEndTime
                    </div>

                </div>
            }
            else
            {
                <p>No upcoming session</p>
            }

        </div>

        <!-- HEALTH PROGRESS -->
        <div class="card">

            <h3>Health Progress</h3>

            @if (string.IsNullOrEmpty(Model.ProgressStatus))
            {
                <p>Not enough data to calculate health progress</p>
            }
            else
            {
                <div class="progress-status @Model.ProgressStatus.ToLower()">
                    @Model.ProgressStatus
                </div>

                <div class="progress-bar">
                    <div class="progress-fill @Model.ProgressStatus.ToLower()"></div>
                </div>

                <p>
                    <strong>Doctor Notes:</strong><br />
                    @Model.DoctorNotes
                </p>
            }

        </div>

    </div>

    <div class="grid">

        <!-- HEALTH SUMMARY -->
        <div class="card">
            <h3>Health Summary</h3>

            @if (Model.Height == null && Model.Weight == null && Model.BMI == null && string.IsNullOrEmpty(Model.BloodPressure))
            {
                <p>No data available</p>
            }
            else
            {
                <div class="summary-grid">

                    <div class="box bmi">
                        <span>BMI</span>
                        <h2>@(Model.BMI?.ToString() ?? "-")</h2>
                    </div>

                    <div class="box weight">
                        <span>Weight</span>
                        <h2>@(Model.Weight != null ? Model.Weight + " kg" : "-")</h2>
                    </div>

                    <div class="box height">
                        <span>Height</span>
                        <h2>@(Model.Height != null ? Model.Height + " cm" : "-")</h2>
                    </div>

                    <div class="box pressure">
                        <span>BP</span>
                        <h2>
                            @(!string.IsNullOrWhiteSpace(Model.BloodPressure) && Model.BloodPressure != "/"
                                                    ? Model.BloodPressure
                                                    : "-")
                        </h2>
                    </div>

                </div>
            }
        </div>

        <!-- LATEST REPORT -->
        <div class="card">

            <h3>Latest Report</h3>

            @{
                var latestReport = Model.ReportGroups?
                .OrderByDescending(r => r.ReportDate)
                .FirstOrDefault();
            }

            @if (latestReport != null)
            {
                <div class="report-box">

                    <h4>@latestReport.TestName</h4>

                    <div class="report-list">
                        @foreach (var r in latestReport.Results)
                        {
                            <div class="report-row">
                                <span>@r.Parameter</span>
                                <span>@r.Value</span>
                                <span class="pill @r.Status.ToLower()">@r.Status</span>
                            </div>
                        }
                    </div>

                    <div class="actions">
                        <a href="@Model.ReportPath" class="btn success">View Report</a>
                        <a href="/Patient/Reports" class="btn primary">View All</a>
                    </div>

                </div>
            }
            else
            {
                <p>No reports available</p>
            }

        </div>

        <!-- PRESCRIPTION -->
        <div class="card">

            <h3>Prescription</h3>

            <div class="medicine-list">

                @if (Model.Medicines.Any())
                {
                    @foreach (var med in Model.Medicines)
                    {
                        <div class="medicine">
                            <strong>@med.Name</strong>
                            <span>@med.Dosage</span>
                        </div>
                    }
                }
                else
                {
                    <p>No medicines assigned</p>
                }

            </div>

            <a href="/Patient/Prescriptions" class="btn primary">
                View All
            </a>

        </div>

    </div>

</div>



<div id="profileModal" class="modal">
    <div class="modal-box" onclick="event.stopPropagation()">

        <span class="close" onclick="closeModal()">&times;</span>

        <h3>Edit Profile</h3>

        <form id="profileForm"
              action="/Patient/Profile/Update"
              method="post">

            @Html.AntiForgeryToken()
            <input type="hidden" name="PatientNIC" value="@Model.NIC" />
            <input id="fullName" name="FullName" value="@Model.PatientName" required />
            <input id="phoneNumber" name="PhoneNumber" value="@Model.PhoneNumber" required />

            <input id="address" name="Address" value="@Model.Address" />

            <div id="formMessage" class="form-message"></div>

            <div class="modal-actions">
                <button type="button" class="btn secondary" onclick="closeModal()">Cancel</button>
                <button type="submit" class="btn success">Save</button>
            </div>
        </form>

    </div>
</div>
