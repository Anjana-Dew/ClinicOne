@model ClinicOne.Models.ViewModels.Patient.PatientDashboardViewModel
@{
    Layout = "_PatientLayout";
}

<link rel="stylesheet" href="~/css/patient/patientDashboardStyles.css" />
<script src="~/js/patient/dashboard.js"></script>

<div class="dashboard">

    <!-- HEADER -->
    <div class="header">
        <h2>Patient Dashboard</h2>
        <p>Overview of your health information</p>
    </div>

    <div class="grid">

        <!-- PROFILE -->
        <div class="card profile">
            <img src="/patientImages/defaultProfile.png" class="profile-img" />

            <h3>@Model.PatientName</h3>

            <div class="info">
                <p><b>NIC:</b> @Model.NIC</p>
                <p><b>Blood Type:</b> @(string.IsNullOrEmpty(Model.BloodType) ? "Not Added" : Model.BloodType)</p>
                <p><b>Phone:</b> @Model.PhoneNumber</p>
                <p><b>Address:</b> @Model.Address</p>
            </div>

            <button class="btn primary" onclick="openModal()">Edit Profile</button>
        </div>

        <!-- SESSION -->
        <div class="card">
            <h3 class="title"><img src="/icons/calendar.png" class="icon" /> Next Session</h3>

            @if (Model.NextSessionDate != null)
            {
                <div class="session-box">
                    <h4>@Model.NextSessionName</h4>
                    <p>@Model.NextSessionDate.Value.ToString("dddd, dd MMM yyyy")</p>
                    <p>@Model.SessionTime</p>
                    <div id="countdown"></div>
                </div>
            }
            else
            {
                <p class="muted">No upcoming session</p>
            }
        </div>

        <!-- PROGRESS -->
        <div class="card">
            <h3 class="title"><img src="/icons/progress.png" class="icon" /> Health Progress</h3>

            <div class="status @Model.ProgressStatus.ToLower()">
                @Model.ProgressStatus
            </div>

            @if (string.IsNullOrEmpty(Model.DoctorNotes))
            {
                <p class="muted">No notes currently</p>
            }
            else
            {
                <p>@Model.DoctorNotes</p>
            }
        </div>

        <!-- VITALS -->
        <div class="card">
            <h3 class="title"><img src="/icons/health.png" class="icon" /> Health Summary</h3>

            <div class="vitals">
                <div><span>BMI</span><h4>@Model.BMI</h4></div>
                <div><span>Weight</span><h4>@Model.Weight kg</h4></div>
                <div><span>Height</span><h4>@Model.Height cm</h4></div>
                <div><span>BP</span><h4>@Model.BloodPressure</h4></div>
            </div>
        </div>

        <!-- REPORT -->
        <div class="card">
            <h3 class="title"><img src="/icons/report.png" class="icon" /> Latest Report</h3>

            @if (Model.ReportResults.Any())
            {
                <table>
                    <tr>
                        <th>Test</th>
                        <th>Parameter</th>
                        <th>Value</th>
                        <th>Status</th>
                    </tr>

                    @foreach (var r in Model.ReportResults)
                    {
                        <tr>
                            <td>@r.TestName</td>
                            <td>@r.Parameter</td>
                            <td>@r.Value</td>
                            <td class="status @r.Status.ToLower()">@r.Status</td>
                        </tr>
                    }
                </table>
            }
            else
            {
                <p class="muted">No reports available</p>
            }
        </div>

        <!-- MEDICINES -->
        <div class="card">
            <h3 class="title"><img src="/icons/medicine.png" class="icon" /> Current Medicines</h3>

            @if (Model.Medicines.Any())
            {
                @foreach (var med in Model.Medicines)
                {
                    <div class="medicine">
                        <strong>@med.Name</strong>
                        <span>@med.Dosage</span>
                    </div>
                }
            }
            else
            {
                <p class="muted">No medicines assigned</p>
            }
        </div>

    </div>
</div>

<!-- MODAL -->
<div id="profileModal" class="modal">
    <div class="modal-box">

        <span class="close" onclick="closeModal()">&times;</span>

        <h3>Edit Profile</h3>

        <form method="post" action="/Patient/Profile/Update">

            <label>Full Name</label>
            <input name="FullName" value="@Model.PatientName" required />

            <label>Phone</label>
            <input name="PhoneNumber" value="@Model.PhoneNumber" required />

            <label>Blood Type</label>
            <input name="BloodType" value="@Model.BloodType" />

            <label>Address</label>
            <input name="Address" value="@Model.Address" />

            <button class="btn success">Save Changes</button>

        </form>

    </div>
