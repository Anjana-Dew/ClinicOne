@model List<ClinicOne.Models.ViewModels.Patient.PatientSessionViewModel>

@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_PatientLayout.cshtml";
}

<link rel="stylesheet" href="~/css/patient/patientSessions.css">

<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">



<div class="report-container">
    <h2>Clinic Sessions</h2>

    @if (!Model.Any())
    {
        <div class="no-results">
            <p>No sessions found.</p>
        </div>
    }
    else
    {
        <div class="session-history">
            <table>
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Session Name</th>
                        <th>Start Time</th>
                        <th>End Time</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var session in Model)
                    {
                        <tr class="@((session.IsNextSession) ? "next-session" : "")">
                            <td>@session.ClinicDate.ToString("yyyy-MM-dd")</td>
                            <td>@session.SessionName</td>
                            <td>@session.StartTime.ToString(@"hh\:mm")</td>
                            <td>@session.EndTime.ToString(@"hh\:mm")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<script src="js/patient/patientDashboard.js"></script>