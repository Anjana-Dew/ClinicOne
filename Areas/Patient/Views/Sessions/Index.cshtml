@{
    Layout = "_PatientLayout";
    var upcoming = ViewBag.Upcoming as List<ClinicOne.Models.ViewModels.Patient.PatientSessionViewModel>;
    var past = ViewBag.Past as List<ClinicOne.Models.ViewModels.Patient.PatientSessionViewModel>;
    var next = ViewBag.NextSession;
}

<link rel="stylesheet" href="~/css/patient/patientSessions.css" />

<div class="session-wrapper">

    <div class="header">
        <h2>Clinic Sessions</h2>
        <p>Track your appointments and upcoming visits</p>
    </div>

    @if (next != null)
    {
        var statusClass = next.Status.ToLower();

        <div class="next-card @statusClass">

            <div class="next-info">
                <h3>@next.SessionName</h3>

                <p class="date">
                    @next.ClinicDate.ToString("yyyy-MM-dd")
                </p>

                <p class="time">
                    @next.StartTime.ToString(@"hh\:mm") -
                    @next.EndTime.ToString(@"hh\:mm")
                </p>
            </div>

            <div class="countdown @(next.Status == "Today" ? "today-pulse" : "")"
                 id="countdown"
                 data-datetime="@next.ClinicDate.Date.Add(next.StartTime).ToString("yyyy-MM-ddTHH:mm:ss")">
                ⏳ Loading...
            </div>

        </div>
    }


    @if ((upcoming == null || !upcoming.Any()) && (past == null || !past.Any()))
    {
        <div class="empty">
            <img src="/patientImages/calendar-empty.png" />
            <h3>No clinic sessions yet</h3>
            <p>Your appointments will appear here</p>
        </div>
    }
    else
    {
        @if (upcoming != null && upcoming.Any())
        {
            <h3 class="section-title">Upcoming Sessions</h3>

            <div class="table-container">
                <table>
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Session</th>
                            <th>Time</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in upcoming)
                        {
                            <tr>
                                <td>@s.ClinicDate.ToString("yyyy-MM-dd")</td>
                                <td>@s.SessionName</td>
                                <td>
                                    @s.StartTime.ToString(@"hh\:mm") -
                                    @s.EndTime.ToString(@"hh\:mm")
                                </td>
                                <td>
                                    <span class="pill @s.Status.ToLower()">
                                        @s.Status
                                    </span>
                                </td>
                            </tr>
                        }

                    </tbody>
                </table>
            </div>
        }

        @if (past != null && past.Any())
        {
            <h3 class="section-title">Past Sessions</h3>

            <div class="table-container">
                <table>
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Session</th>
                            <th>Time</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in past)
                        {
                            <tr>
                                <td>@s.ClinicDate.ToString("yyyy-MM-dd")</td>
                                <td>@s.SessionName</td>
                                <td>
                                    @s.StartTime.ToString(@"hh\:mm") -
                                    @s.EndTime.ToString(@"hh\:mm")
                                </td>
                                <td>
                                    <span class="pill completed">Completed</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }

</div>

@section Scripts {
    <script>
        const el = document.getElementById("countdown");

        if (el) {
            const target = new Date(el.dataset.datetime);

            function updateCountdown() {
                const now = new Date();
                const diff = target - now;

                if (diff <= 0) {
                    el.innerText = "Ongoing / Today";
                    el.classList.add("today-pulse");
                    return;
                }

                const days = Math.floor(diff / (1000 * 60 * 60 * 24));
                const hours = Math.floor((diff / (1000 * 60 * 60)) % 24);
                const minutes = Math.floor((diff / (1000 * 60)) % 60);

                el.innerText = `${days}d ${hours}h ${minutes}m left`;
            }

            updateCountdown(); 
            setInterval(updateCountdown, 60000);
        }
    </script>
}