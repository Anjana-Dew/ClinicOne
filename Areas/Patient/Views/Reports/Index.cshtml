@model List<ClinicOne.Models.ViewModels.Patient.PatientReportViewModel>

@{
    Layout = "~/Views/Shared/_PatientLayout.cshtml";
}

<link rel="stylesheet" href="~/css/patient/patientReports.css" />

<div class="report-container">
    <h2>Laboratory Reports</h2>

    <div class="filters">
        <input type="text" id="searchInput" placeholder="Search Test Name..." />
        <input type="date" id="dateFilter" />
    </div>

    @if (ViewBag.NoResults == true)
    {
        <div class="no-results">
            <img src="/images/no-data.png" />
            <h3>No Test Results Found</h3>
            <p>You currently have no laboratory reports.</p>
        </div>
    }
    else
    {
        <table id="reportTable">
            <thead>
                <tr>
                    <th>Report ID</th>
                    <th>Test Name</th>
                    <th>Parameters</th>
                    <th>Date</th>
                    <th>Status</th>
                    <th>Download</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model)
                {
                    <tr class="@(r.ReportStatus == "Pending" ? "pending-row" : "")">
                        <td>@r.ReportID</td>
                        <td>@r.TestName</td>
                        <td>
                            @foreach(var p in r.Parameters)
                            {
                                <div>
                                    <span>@p.ParameterName: @p.TestValue</span>
                                    <span class="status @p.ResultStatus.ToLower()">@p.ResultStatus</span>
                                </div>
                            }
                            @if (!r.Parameters.Any() && r.ReportStatus == "Pending")
                            {
                                <span class="pending-badge">Results Pending</span>
                            }
                        </td>
                        <td>@r.ReportDate.ToShortDateString()</td>
                        <td>@r.ReportStatus</td>
                        <td>
                            @if (r.ReportStatus == "Completed")
                            {
                                <a href="@r.ReportPath" class="download-btn" download>Download PDF</a>
                            }
                            else
                            {
                                
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@section Scripts {
    <script src="~/js/patient/patientReports.js"></script>
}