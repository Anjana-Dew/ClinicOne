@model List<ClinicOne.Models.ViewModels.Patient.PatientReportViewModel>

@{
    Layout = "~/Views/Shared/_PatientLayout.cshtml";
}

<link rel="stylesheet" href="~/css/patient/patientReports.css" />

<div class="report-wrapper">

    <div class="header">
        <h2>Laboratory Reports</h2>
        <p>View and download your medical test results</p>
    </div>

    <form method="get" class="filter-bar">

        <input type="text" name="search"
               placeholder="Search test..."
               value="@Context.Request.Query["search"]" />

        <input type="date" name="date"
               value="@Context.Request.Query["date"]" />

        <select name="panelId">
            <option value="">All Tests</option>
            @foreach (var p in ViewBag.TestPanels)
            {
                <option value="@p.PanelID"
                        selected="@(Context.Request.Query["panelId"] == p.PanelID.ToString())">
                    @p.TestName
                </option>
            }
        </select>

        <select name="status">
            <option value="">All Status</option>
            <option value="Normal">Normal</option>
            <option value="High">High</option>
            <option value="Risk">Risk</option>
        </select>

        <button type="submit" class="btn primary">Filter</button>
        <button type="button" class="btn clear" onclick="clearFilters()">Clear</button>

    </form>

    @if (ViewBag.NoResults == true)
    {
        <div class="no-data">
            <img src="/patientImages/no-data.png" />
            <h3>No Reports Found</h3>
            <p>Try adjusting filters</p>
        </div>
    }
    else
    {

        <div class="table-container">
            <table>
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Test</th>
                        <th>Results</th>
                        <th>Date</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>

                <tbody>
                    @{
                        var latestDate = Model.Any() ? Model.Max(x => x.ReportDate) : DateTime.MinValue;
                    }

                    @foreach (var r in Model)
                    {
                        var isLatest = r.ReportDate == latestDate;

                        <tr class="@(isLatest ? "latest" : (r.ReportStatus == "Pending" ? "pending" : ""))">

                            <td>#@r.ReportID</td>

                            <td>
                                <div class="test-name">
                                    @r.TestName

                                    @if (isLatest)
                                    {
                                        <span class="badge-new">NEW</span>
                                    }
                                </div>
                            </td>

                            <td>
                                @if (r.Parameters.Any())
                                {
                                    foreach (var p in r.Parameters)
                                    {
                                        <div class="param">
                                            <span>@p.ParameterName: @p.TestValue</span>

                                            <span class="status @r.ReportStatus.ToLower()">
                                                @r.ReportStatus
                                            </span>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <span class="pill pending-pill">Pending</span>
                                }
                            </td>

                            <td>@r.ReportDate.ToString("yyyy-MM-dd")</td>

                            <td>
                                <span class="status @(r.ReportStatus == "Pending" ? "pending-status" : "ok")">
                                    @r.ReportStatus
                                </span>
                            </td>

                            <td>
                                @if (r.Parameters.Any())
                                {
                                    <a href="@Url.Content(r.ReportPath)" download class="btn download">
                                        ⬇ Download
                                    </a>
                                }
                                else
                                {
                                    <span class="disabled">-</span>
                                }
                            </td>

                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

</div>

<script>
    function clearFilters() {
        const form = document.querySelector(".filter-bar");
        form.reset();
        form.submit();
    }

    document.addEventListener("DOMContentLoaded", function () {

        document.addEventListener("click", async function (e) {

            const btn = e.target.closest(".confirm-btn");
            if (!btn) return;

            const id = btn.getAttribute("data-id");

            console.log("clicked:", id);

            try {
                const res = await fetch('/Patient/Prescriptions/Confirm', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ id })
                });

                const data = await res.json();
                console.log("response:", data);

                if (data.success) {
                    location.reload();
                } else {
                    alert("Failed");
                }
            }
            catch (err) {
                console.error(err);
                alert("Server error");
            }
        });

    });

</script>

