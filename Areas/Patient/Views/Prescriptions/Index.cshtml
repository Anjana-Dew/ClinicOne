@model List<ClinicOne.Models.ViewModels.Patient.PatientPrescriptionViewModel>

@{
    Layout = "_PatientLayout";
    var active = Model?.Where(x => x.IsActive).OrderByDescending(x => x.PrescriptionDate).ToList() ?? new();
    var past = Model?.Where(x => x.IsPast).OrderByDescending(x => x.PrescriptionDate).ToList() ?? new();
}

@Html.AntiForgeryToken()

<link rel="stylesheet" href="~/css/patient/patientPrescriptions.css" />

<div class="wrapper">

    <div class="header">
        <h2>My Prescriptions</h2>
        <p>Check your medicines, pharmacy status, and external prescriptions</p>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="empty">
            <img src="/patientImages/calendar-empty.png" />
            <h3>No Prescriptions Found</h3>
            <p>No prescriptions have been issued yet.</p>
        </div>
    }
    else
    {
        <div id="msgBox" class="form-message"></div>

        @for (int i = 0; i < active.Count; i++)
        {
            var p = active[i];
            <div class="card active">

                <div class="card-header">
                    <h3>
                        Prescription #@p.PrescriptionID
                        @if (i == 0)
                        {
                            <span class="latest-badge">Latest</span>
                        }
                    </h3>
                    <span>@p.PrescriptionDate.ToString("yyyy-MM-dd")</span>
                </div>

                @if (!string.IsNullOrEmpty(p.Notes))
                {
                    <p class="notes">@p.Notes</p>
                }

                <div class="medicine-list">
                    @foreach (var m in p.Medicines)
                    {
                        <div class="medicine-item">
                            <div class="medicine-info">
                                <strong>@m.MedicineName</strong>
                                <small>@m.Dosage • @m.TimesPerDay x/day • @m.Duration</small>
                                @if (m.Status == "Not Given" && !string.IsNullOrEmpty(m.Reason))
                                {
                                    <small class="reason">Reason: @m.Reason</small>
                                }
                            </div>
                            @{
                                var statusLabel = m.Status switch
                                {
                                                        "Given" => "Given",
                                                        "Not Given" => "Not Given",
                                                        "Partially Given" => "Partial",
                                    _ => "Pending Pharmacy"
                                };
                                var statusClass = m.Status switch
                                {
                                                        "Given" => "pill done",
                                                        "Not Given" => "pill not-given",
                                                        "Partially Given" => "pill partial",
                                    _ => "pill pending"
                                };
                            }
                            <span class="@statusClass">@statusLabel</span>
                        </div>
                    }
                </div>

                <div class="actions">

                    @if (p.PharmacyPending)
                    {
                        <span class="info-text">Pending pharmacy processing</span>
                    }

                    @if (p.AllGiven && !p.ShowCompleted)
                    {
                        <span class="info-text success-text">All medicines dispensed</span>
                    }

                    @if (p.ShowConfirmButton)
                    {
                        <button class="btn confirm"
                                onclick="confirmExternalPrescription(@p.PrescriptionID, this)">
                            Confirm You Took External Prescription
                        </button>
                    }

                    @if (!string.IsNullOrEmpty(p.PDFPath))
{
                <a href="@Url.Content("~" + p.PDFPath)" target="_blank" class="btn download">
                View External Prescription PDF
                 </a>
}

                    @if (p.ShowCompleted)
                    {
                        <span class="info-text success-text">Completed</span>
                    }

                </div>
            </div>
        }

        @if (past.Any())
        {
            <h3 class="section-title">Past Prescriptions</h3>

            @for (int i = 0; i < past.Count; i++)
            {
                var p = past[i];
                <div class="card history">

                    <div class="accordion-header" onclick="toggleAccordion(@i)">
                        <h4>
                            Prescription #@p.PrescriptionID
                            <span style="font-size:13px; color:#666; font-weight:400; margin-left:8px;">
                                @p.PrescriptionDate.ToString("yyyy-MM-dd")
                            </span>
                        </h4>
                        <span class="accordion-toggle" id="toggle-icon-@i">Show</span>
                    </div>

                    <div class="accordion-body" id="accordion-body-@i">
                        <div class="medicine-list" style="margin-top:12px;">
                            @foreach (var m in p.Medicines)
                            {
                                <div class="medicine-item">
                                    <div>
                                        <strong>@m.MedicineName</strong>
                                        <small>@m.Dosage • @m.TimesPerDay x/day • @m.Duration</small>
                                    </div>
                                    @{
                                        var sl = m.Status switch
                                        {
                                                                    "Given" => "Given",
                                                                    "Not Given" => "Not Given",
                                                                    "Partially Given" => "Partial",
                                            _ => "Pending"
                                        };
                                        var sc = m.Status switch
                                        {
                                                                    "Given" => "pill done",
                                                                    "Not Given" => "pill not-given",
                                                                    "Partially Given" => "pill partial",
                                            _ => "pill pending"
                                        };
                                    }
                                    <span class="@sc">@sl</span>
                                </div>
                            }
                        </div>
                        <p class="expired-note">This prescription has expired.</p>
                    </div>

                </div>
            }
        }
    }

</div>

<script>
    function toggleAccordion(index) {
        const body = document.getElementById(`accordion-body-${index}`);
        const icon = document.getElementById(`toggle-icon-${index}`);
        const isOpen = body.classList.contains("open");
        body.classList.toggle("open", !isOpen);
        icon.textContent = isOpen ? "▾ Show" : "▴ Hide";
    }

    async function confirmExternalPrescription(prescriptionId, btn) {
        const msgBox = document.getElementById("msgBox");
        msgBox.className = "form-message";
        msgBox.innerHTML = "Processing...";

        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

        try {
            const res = await fetch(`/Patient/Prescriptions/ConfirmExternal?id=${prescriptionId}`, {
                method: "POST",
                headers: { "RequestVerificationToken": token }
            });

            const data = await res.json();

            if (data.success) {
                msgBox.className = "form-message success";
                msgBox.innerHTML = data.message;

                btn.style.display = "none";

                const done = document.createElement("span");
                done.className = "info-text success-text";
                done.innerHTML = "Completed";
                btn.parentElement.appendChild(done);
            } else {
                msgBox.className = "form-message error";
                msgBox.innerHTML = data.message || "Failed to confirm.";
            }
        } catch (err) {
            console.error(err);
            msgBox.className = "form-message error";
            msgBox.innerHTML = "Server error.Try again.";
        }
    }
</script>
