@using ClinicOne.Models.ViewModels.Admin
@model UploadTestReportViewModel

<link rel="stylesheet" href="~/css/admin/testReportsStyles.css" />

<div class="test-report-management">
    <div class="header-bar">
        <a href="/Admin/TestReports/Index" class="back-btn">
            <img src="~/adminImages/ic_back.png" alt="Back" />
        </a>
        <img src="~/images/ClinicOneLogoMain.png" alt="Logo" class="logo" />
    </div>
    <div class="upload-container">
        
        <div id="validationMessage" class="validation-message" style="display:none;"></div>
        <h1>Upload Test Report</h1>

        <div class="patient-info">
            <strong>Patient :</strong> @Model.PatientName
        </div>

        <input type="hidden" id="patientNIC" value="@Model.PatientNIC" />
        <div class="form-group">
            <select id="panelSelect">
                <option value="">Select Panel</option>
                @foreach (var panel in Model.Panels)
                {
                    <option value="@panel.PanelID">@panel.TestName</option>
                }
            </select>
        </div>

        <div id="parametersContainer"></div>

        <div class="form-group">
            <label>Upload PDF</label>
            <input type="file" id="pdfFile" accept="application/pdf" />
        </div>

        <button onclick="saveReport()" class="save-btn">
            Save Report
        </button>
    </div>
    <div id="confirmModal" class="confirm-modal">
        <div class="confirm-box">
            <h3>Confirm Test Report</h3>

            <p>
                Please confirm this is the correct patient and all test values are correct.
                <br /><br />
                <strong>This action cannot be undone</strong>
            </p>
            <div class="confirm-actions">
                <button id="cancelSave" class="btn-cancel">Back</button>
                <button id="confirmSave" class="btn-confirm">Continue</button>
            </div>
        </div>
    </div>
</div>


<script src="~/js/admin/uploadTestReportScript.js"></script>