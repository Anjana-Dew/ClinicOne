@{
    Layout = "_AdminLayout";
}
@if (TempData["Error"] != null)
{
    <div class="error-message">
        @TempData["Error"]
    </div>
}

@if (TempData["Success"] != null)
{
    <div class="success-message">
        @TempData["Success"]
    </div>
}
<link rel="stylesheet" href="~/css/admin/changePasswordStyles.css" />
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap" rel="stylesheet">

<div class="password-management">

    <h2 class="title">Password Management</h2>

    <section class="password-change-section">

        <form id="resetForm" method="post" asp-action="ResetPassword">

            <div class="form-group">
                <label>Username</label>
                <input type="text" name="username" placeholder="Enter NIC / Email / Registration Number" required />
            </div>

            <div class="form-group">
                <label>New Password</label>
                <input type="text" name="newPassword" placeholder="Enter new password" required />
            </div>

            <button type="button" id="openConfirm" class="reset-btn">Reset Password</button>

        </form>

    </section>
</div>
<div id="confirmModal" class="confirm-modal">

    <div class="confirm-box">

        <h3>Confirm Password Reset</h3>

        <p>Are you sure you want to reset this user's password?</p>

        <div class="confirm-actions">
            <button id="cancelReset" class="cancel-btn">Cancel</button>
            <button id="confirmReset" class="confirm-btn">Continue</button>
        </div>

    </div>

</div>
<script src="~/js/admin/passwordManagementScript.js"></script>
