@using ClinicOne.Models.ViewModels.Admin
@{
    Layout = "_AdminLayout";
}
@model RegisterPharmacistViewModel
<link rel="stylesheet" href="~/css/admin/pharmacistsStyles.css" />
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap" rel="stylesheet">

@if (TempData["SuccessMessage"] != null)
{
    <div class="success-message" id="successAlert">
        <span>@TempData["SuccessMessage"]</span>
        <button type="button" class="close-btn" onclick="closeAlert()">×</button>
    </div>
}

<div class="pharmacist-management">
    <h1 class="title">Pharmacist Management</h1>

    <section class="search-section">

        <h2 class="section-title">Search Pharmacists</h2>

        <div class="search-container">
            <input type="text" id="searchRegNo" placeholder="Enter Registration Number" class="search-input" />
            <button type="button" class="search-btn" onclick="searchPharmacist()">Search</button>
        </div>

        <div id="searchResult" class="search-result"></div>

    </section>

    <section class="register-section">

        <h2 class="section-title">Register Pharmacist</h2>
        @Html.AntiForgeryToken()
        <div asp-validation-summary="All" class="validation-summary"></div>
        <form method="post" asp-action="Register">

            <div class="form-group">
                <label>Full Name *</label>
                <input type="text" asp-for="Name" class="form-input" />
                <span asp-validation-for="Name" class="error-msg"></span>
            </div>

            <div class="form-group">
                <label>Registartion Number *</label>
                <input type="text" asp-for="RegistrationNumber" class="form-input" />
                <span asp-validation-for="RegistrationNumber" class="error-msg"></span>
            </div>

            <div class="form-actions">
                <button type="submit" class="register-btn">
                    Register
                </button>

                <a asp-area="Admin"
                   asp-controller="Pharmacists"
                   asp-action="Index"
                   class="cancel-btn">
                    Cancel
                </a>
            </div>

        </form>
    </section>
</div>

<script src="~/js/admin/adminPharmacistScript.js"></script>
