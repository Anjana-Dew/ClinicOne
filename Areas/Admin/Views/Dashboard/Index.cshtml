@{
    Layout = "_AdminLayout";
}

<link rel="stylesheet" href="~/css/admin/adminDashboardStyles.css" />
<script src="~/js/admin/adminDashboard.js"></script>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap" rel="stylesheet">

<h2 class="dashboard-title">Dashboard</h2>

<div class="dashboard-cards">

    <div class="dashboard-card">
        <!--<h3>Patients</h3>-->
        <img src="~/adminImages/patient_icon.png" alt="Patients"/>
        <p class="card-count">Total Patients: @ViewBag.PatientCount</p>
    </div>

    <div class="dashboard-card">
        <!--<h3>Doctors</h3>-->
        <img src="~/adminImages/doctor_icon.png" alt="Dctors" />
        <p class="card-count">Total Doctors: @ViewBag.DoctorCount</p>
    </div>
    <div class="dashboard-card">
        <img src="~/adminImages/pharmacist_icon.png" alt="Pharmacists" />
        <p class="card-count">Total Pharmacists: @ViewBag.PharmacistCount</p>
    </div>
    <div class="dashboard-card">
        <img src="~/adminImages/admin_icon.png" alt="Pharmacists" />
        <p class="card-count">Total Admins: @ViewBag.AdminCount</p>
    </div>


</div>

<section class="recent-activity-section">

    <h2 class="section-title">Recent Activity</h2>

    <div class="activity-card">
        
        @if(ViewBag.RecentLogs != null && ViewBag.RecentLogs.Count > 0)
        {
            var logs = ViewBag.RecentLogs;

            for(int i = 0; i < logs.Count; i++)
            {
                <div class="activity-item">
                    <p>
                        <strong>@logs[i].DoctorName</strong>
                        @logs[i].Action
                        patient <strong>@logs[i].PatientNIC</strong> profile
                    </p>

                    <span class="activity-time">
                        @(DateTime.Now.Subtract(logs[i].AccessDateTime).TotalMinutes < 60
                                        ? $"{(int)DateTime.Now.Subtract(logs[i].AccessDateTime).TotalMinutes} minutes ago"
                                        : logs[i].AccessDateTime.ToString("g"))
                    </span>
                </div>

                @if( i < logs.Count - 1)
                {
                    <div class="activity-divider"></div>
                }
            }
        }
        else
        {
            <p class="empty-activity">No recent activity</p>
        }
    </div>
</section>
