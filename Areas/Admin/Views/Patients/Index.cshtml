@{
    Layout = "_AdminLayout";
}
@model ClinicOne.Models.ViewModels.RegisterPatientViewModel

<link rel="stylesheet" href="~/css/admin/PatientsStyles.css" />
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap" rel="stylesheet">

@if (TempData["SuccessMessage"] != null)
{
    <div class="success-message" id="successAlert">
        <span>@TempData["SuccessMessage"]</span>
        <button type="button" class="close-btn" onclick="closeAlert()">×</button>
    </div>
}

<div class="patient-management">

    <h1 class="title">Patient Management</h1>
    <section class="search-patient-section">
        <h2 class="search-patient-title"> Search Patients </h2>

        <div class="search-container">
            <input type="text" id="searchNIC" placeholder="Enter Patient NIC..." class="search-input" />
            <button type="button" class="search-btn" onclick="searchPatient()">Search</button>
        </div>

        <div class="search-result" id="searchResult">
            <p class="result-placeholder"></p>
        </div>
    </section>

    <section class="register-patients-section">
        <h2 class="register-patient-title">Register Patients</h2>

        <form asp-area="Admin" asp-controller="Patients" asp-action="Register" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="All" class="validation-summary"></div>
            <div class="register-container">

                <div class="form-row">

                    <div class="form-group">
                        <label>Full Name *</label>
                        <input type="text" class="form-input" asp-for="FullName"/>
                        <span asp-validation-for="FullName"></span>
                    </div>

                    <div class="form-group">
                        <label>NIC *</label>
                        <input type="text" class="form-input" asp-for="NIC" />
                        <span asp-validation-for="NIC"></span>
                    </div>

                </div>

                <div class="form-row">

                    <div class="form-group">
                        <label>Date of Birth *</label>
                        <input type="date" class="form-input" asp-for="DOB" />
                        <span asp-validation-for="DOB"></span>
                    </div>

                    <div class="form-group">
                        <label>Gender *</label>
                        <select class="form-input" asp-for="Gender" >
                            <option value="">Select Gender</option>
                            <option value="M">Male</option>
                            <option value="F">Female</option>
                        </select>
                        <span asp-validation-for="Gender"></span>
                    </div>

                </div>

                <div class="form-group full-width">
                    <label>Address *</label>
                    <input type="text" class="form-input" asp-for="Address" />
                    <span asp-validation-for="Address"></span>
                </div>

                <div class="form-row">

                    <div class="form-group">
                        <label>Phone Number *</label>
                        <input type="text" class="form-input" asp-for="PhoneNumber" />
                        <span asp-validation-for="PhoneNumber"></span>
                    </div>

                    <div class="form-group">
                        <label>Blood Type</label>
                        <select class=" form-input" asp-for="BloodType">
                            <option value="">Select</option>
                            <option>A+</option>
                            <option>A-</option>
                            <option>B+</option>
                            <option>B-</option>
                            <option>O+</option>
                            <option>O-</option>
                            <option>AB+</option>
                            <option>AB-</option>
                        </select>
                        <span asp-validation-for="BloodType"></span>
                    </div>
                </div>

                <div class="form-row">

                    <div class="form-group">
                        <label>Height (cm)</label>
                        <input type="number" step="0.01" class="form-input" asp-for="Height" />
                        <span asp-validation-for="Height"></span>
                    </div>

                    <div class="form-group">
                        <label>Weight (Kg)</label>
                        <input type="number" step="0.01" class="form-input" asp-for="Weight" />
                        <span asp-validation-for="Weight"></span>
                    </div>

                </div>

                <div class="form-group full-width">
                    <label>Blood Pressure</label>
                    <input type="text" class="form-input" placeholder="e.g. 120/80" asp-for="BloodPressure" />
                    <span asp-validation-for="BloodPressure"></span>
                </div>

                <div class="register-btn-container">
                    <button type="submit" class="register-btn">Register Patient</button>
                    @* <button type="reset" class="cancel-btn">Cancel</button> *@
                    <a asp-area="Admin"
                       asp-controller="Patients"
                       asp-action="Index"
                       class="cancel-btn">
                        Cancel
                    </a>
                </div>

            </div>
        </form>
    </section>
</div>

<script src="~/js/admin/adminPatientScript.js"></script>
