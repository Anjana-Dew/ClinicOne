<!DOCTYPE html>
    <html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Pharmacist Portal - ClinicOne</title>

        <link rel="stylesheet" href="~/css/pharmacist/pharmacistLayout.css" />

        <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap" rel="stylesheet">
    </head>

    <body>
        @RenderBody()
        @RenderSection("Scripts" , required:false)

        <header>
            <div class="header-left">
                <div class="header-logo">
                    <img src="~/images/logo_White.png" class="logo" />
                </div>
            </div>

            <div class="header-text">
                <h1>Pharmacist Portal - ClinicOne</h1>
            </div>

            <div class="header-right">
                <a asp-controller="Account" asp-action="Logout" asp-area="" class="logout-btn">
    <img src="~/pharmacistImages/logout.png" class="logout-icon" alt="Logout" />
</a>
            </div>

            </header>
        <main class="pharmacist-main">
            @RenderBody()
        </main>

    </body>
    </html>
