@{
    var patientName = ViewBag.PatientName ?? "Patient";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>ClinicOne</title>

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/patient/patientLayout.css" asp-append-version="true" />
</head>
<body>

    <!-- NAVBAR -->
    <header class="navbar">
        <div class="logo">
            <img src="~/patientImages/logo.png" alt="ClinicOne Logo" class="logo-img" />
            <span>ClinicOne</span>
        </div>
            

        <ul class="nav-links">
            <li>
                <a asp-area="Patient"
                   asp-controller="Dashboard"
                   asp-action="Index">Dashboard</a>
            </li>

            <li>
                <a asp-area="Patient"
                   asp-controller="Dashboard"
                   asp-action="Reports">Reports</a>
            </li>

            <li>
                <a asp-area="Patient"
                   asp-controller="Dashboard"
                   asp-action="Sessions">Sessions</a>
            </li>

            <li>
                <a asp-area="Patient"
                   asp-controller="Dashboard"
                   asp-action="Prescriptions">Prescriptions</a>
            </li>
        </ul>

        <div class="profile">
            <div class="bell">
                🔔
                <span class="badge">3</span>
            </div>

            <span id="currentDateTime"></span>

            <span class="user-name">@patientName</span>
        </div>
    </header>

    <!-- PAGE CONTENT -->
    <main class="main-content">
        @RenderBody()
    </main>

    <!-- FOOTER -->
    <footer class="footer">
        <div class="footer-container">

            <div class="footer-brand">
                <h3>ClinicOne</h3>
                <p>Smart Healthcare Management System</p>
            </div>

            <div class="footer-contact">
                <p>📞 +94 77 123 4567</p>
                <p>📧 support@clinicone.lk</p>
            </div>

            <div class="footer-right">
                <p>© <span id="year"></span> ClinicOne</p>
                <p>All Rights Reserved</p>
            </div>

        </div>
    </footer>

    <script src="~/js/patient/patientLayout.js"></script>

    @RenderSection("Scripts", required: false)

</body>
</html>