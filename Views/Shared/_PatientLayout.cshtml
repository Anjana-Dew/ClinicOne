@using ClinicOne.Models.Entities

@{
    var patientName = ViewBag.PatientName ?? "Patient";
    var hasNotifications = ViewBag.HasNotifications ?? false;
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>ClinicOne</title>

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="~/css/patient/patientLayout.css" asp-append-version="true" />
    <script src="/js/patient/notifications.js"></script>

</head>

<body>

    <header class="navbar">

        <div class="nav-left">

            <a asp-area="Patient"
               asp-controller="Dashboard"
               asp-action="Index"
               class="logo">

                <img src="~/images/logo_White.png" alt="ClinicOne Logo">
                <span>ClinicOne</span>

            </a>

        </div>


        <nav class="nav-center">

            <a asp-area="Patient"
               asp-controller="Dashboard"
               asp-action="Index">
                Dashboard
            </a>

            <a asp-area="Patient"
               asp-controller="Reports"
               asp-action="Index">
                Reports
            </a>

            <a asp-area="Patient"
               asp-controller="Sessions"
               asp-action="Index">
                Sessions
            </a>

            <a asp-area="Patient"
               asp-controller="Prescriptions"
               asp-action="Index">
                Prescriptions
            </a>

            <a asp-area="Patient"
               asp-controller="Notes"
               asp-action="Index">
                Notes
            </a>

        </nav>


        <div class="nav-right">


            <div class="date-pill">
                <span id="currentDateTime"></span>
            </div>

          <div class="notification">
    <a asp-area="Patient"
       asp-controller="Notification"
       asp-action="Index">

        <img src="~/patientImages/bell.png" class="bell-icon" />

        @if (ViewBag.UnreadCount != null && (int)ViewBag.UnreadCount > 0)
        {
            <span class="badge"></span>
        }

    </a>
</div>
            <a asp-controller="Account"
               asp-action="Logout"
               asp-area=""
               class="logout-btn">
                Logout
            </a>

        </div>

    </header>

    <main class="main-content">

        @RenderBody()

    </main>


    <footer class="footer">

        <p>© 2026 ClinicOne. All Rights Reserved.</p>

    </footer>


    <script src="~/js/patient/patientLayout.js"></script>

    @RenderSection("Scripts", required: false)

</body>

</html>