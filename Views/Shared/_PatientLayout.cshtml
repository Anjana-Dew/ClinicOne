@{
    var patientName = ViewBag.PatientName ?? "Patient";
    var hasNotifications = ViewBag.HasNotifications ?? true;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>ClinicOne</title>

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/patient/patientLayout.css" asp-append-version="true" />
</head>
<body>
    <header class="navbar">

        <div class="nav-left">
            <div class="logo">
                <img src="~/images/logo_White.png" alt="Logo">
                <span>ClinicOne</span>
            </div>
        </div>

       
        <nav class="nav-center">
            <a asp-area="Patient" asp-controller="Dashboard" asp-action="Index">Dashboard</a>
            <a asp-area="Patient" asp-controller="Dashboard" asp-action="Reports">Reports</a>
            <a asp-area="Patient" asp-controller="Dashboard" asp-action="Sessions">Sessions</a>
            <a asp-area="Patient" asp-controller="Dashboard" asp-action="Prescriptions">Prescriptions</a>
        </nav>

       
        <div class="nav-right">

            <span id="currentDateTime" class="datetime"></span>

            <div class="notification">
                <span class="bell">🔔</span>
                <span class="badge"></span>
            </div>

            <button class="logout-btn">
                Logout
            </button>

        </div>

    </header>
    <main class="main-content">
        @RenderBody()
    </main>

    <footer class="footer">
        <p>© 2026 ClinicOne. All Rights Reserved.</p>
    </footer>

    <script src="~/js/patient/patientLayout.js"></script>
    @RenderSection("Scripts", required: false)

</body>
</html>
