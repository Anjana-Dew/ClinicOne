@{
	var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
	var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
}
<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>Admin Portal - ClinicOne</title>
		<link rel="stylesheet" href="~/css/admin/adminLayout.css" />
		<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap" rel="stylesheet">
	</head>
	<body>
		<header>
			<div class="header-left">
				<button id="sidebarToggle" class="toggle-btn">☰</button>
				<div class="header-logo">
					<img src="~/images/logo_White.png" alt="ClinicOne Logo" class="logo" />
				</div>
			</div>
			<div class="header-text">
				<h1>Admin Portal - ClinicOne</h1>
			</div>
		</header>
		<div class="admin-container">
			<aside class="admin-sidebar" id="sidebar">
				<nav class="sidebar-menu">
					<ul>

						<li class="@(currentController == "Dashboard" ? "active" : "")">
							<a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Dashboard</a>
						</li>

						<li class="@(currentController == "Patients" ? "active" : "")">
							<a asp-area="Admin" asp-controller="Patients" asp-action="Index">Patients</a>
						</li>

						<li class="@(currentController == "Pharmacists" ? "active" : "")">
							<a asp-area="Admin" asp-controller="Pharmacists" asp-action="Index">Pharmacists</a>
						</li>

						<li class="@(currentController == "Doctors" ? "active" : "")">
							<a asp-area="Admin" asp-controller="Doctors" asp-action="Index">Doctors</a>
						</li>
					@if (Context.Session.GetString("Username") == "mainadmin@clinic.com")
					{
						<li class="@(currentController == "Admins" ? "active" : "")">
							<a asp-area="Admin" asp-controller="Admins" asp-action="Index">Admins</a>
						</li>
					}
						<li class="@(currentController == "ClinicSessions" ? "active" : "")">
							<a asp-area="Admin" asp-controller="ClinicSessions" asp-action="Index">Clinic Sessions</a>
						</li>

						<li class="@(currentController == "DoctorDutySchedule" ? "active" : "")">
							<a asp-area="Admin" asp-controller="DoctorDutySchedule" asp-action="Index">Duty Schedule</a>
						</li>
					
						<li class="@(currentController == "TestReports" ? "active" : "")">
							<a asp-area="Admin" asp-controller="TestReports" asp-action="Index">Test Reports</a>
						</li>

						<li class="@(currentController == "AccessLog" ? "active" : "")">
							<a asp-area="Admin" asp-controller="AccessLog" asp-action="Index">Access Log</a>
						</li>
					@if (Context.Session.GetString("Username") == "mainadmin@clinic.com")
					{
						<li>
							<a asp-area="Admin" asp-controller="PasswordManagement" asp-action="Index">
								Password Management
							</a>
						</li>
					}

					</ul>
				</nav>
				<div class="sidebar-logout">
					<a href="/Account/Logout" class="logout-btn">Logout</a>
				</div>
			</aside>
			<main class="admin-main">
				@RenderBody()
			</main>
		</div>
	<script src="~/js/admin/adminLayoutScript.js"></script>
	</body>
</html>