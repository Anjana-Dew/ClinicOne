<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>Admin Portal - ClinicOne</title>
		<link rel="stylesheet" href="~/css/admin/adminLayout.css" />
		<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap" rel="stylesheet">
	</head>
	<body>
		<header>
			<div class="header-left">
				<button id="sidebarToggle" class="toggle-btn">☰</button>
				<div class="header-logo">
					<img src="~/images/logo_White.png" alt="ClinicOne Logo" class="logo" />
				</div>
			</div>
			<div class="header-text">
				<h1>Admin Portal - ClinicOne</h1>
			</div>
		</header>
		<div class="admin-container">
			<aside class="admin-sidebar" id="sidebar">
				<nav>
					<ul>
						<li class="active">
							<a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Dashboard</a>
						</li>
						<li>
							<a asp-area="Admin" asp-controller="Patients" asp-action="Index">Patients</a>
						</li>
						<li>
							<a asp-area="Admin" asp-controller="Pharmacists" asp-action="Index">Pharmacists</a>
						</li>
						<li>
							<a asp-area="Admin" asp-controller="Doctors" asp-action="Index">Doctors</a>
						</li>
						<li>
							<a asp-area="Admin" asp-controller="ClinicSessions" asp-action="Index">Clinic Sessions</a>
						</li>
						<li>
							<a asp-area="Admin" asp-controller="DoctorDutySchedule" asp-action="Index">Duty Schedule</a>
						</li>
						<li>
							<a asp-area="Admin" asp-controller="TestReports" asp-action="Index">Test Reports</a>
						</li>
						<li>
							<a asp-area="Admin" asp-controller="AccessLog" asp-action="Index">Access Log</a>
						</li>

					</ul>
				</nav>
			</aside>
			<main class="admin-main">
				@RenderBody()
			</main>
		</div>
	<script>
		document.getElementById("sidebarToggle")
			.addEventListener("click", function () {
				document.getElementById("sidebar")
					.classList.toggle("collapsed");
			});
	</script>
	</body>
</html>